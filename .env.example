# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# ---- API ----
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Only set to "true" on machines behind a corporate SSL-inspection proxy
# (e.g. Forcepoint) that Node can't build a trust chain through. Disables TLS
# certificate verification for this process — dev only, never set in
# production, ignored entirely when NODE_ENV=production.
DEV_INSECURE_TLS=

# ---- Field link tokens (independent from Supabase Auth) ----
FIELD_TOKEN_SECRET=replace-with-a-long-random-string
FIELD_TOKEN_DEFAULT_EXPIRY_DAYS=7

# ---- Report defaults ----
REPORT_DEFAULT_VALIDITY_MONTHS=12

# ---- Mercado Pago (billing) ----
# Leave empty to run the PaymentProvider in mock/log mode.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---- Signature provider (ICP-Brasil) ----
# Leave empty to run the SignatureProvider in mock mode.
SIGNATURE_PROVIDER=mock
SIGNATURE_PROVIDER_API_KEY=

# ---- Email (Resend) ----
# Leave empty to run the EmailProvider in log-only mode.
RESEND_API_KEY=
EMAIL_FROM=laudos@zoppi.com.br

# ---- WhatsApp ----
# Leave empty to run the WhatsAppProvider in log-only mode.
WHATSAPP_PROVIDER_API_KEY=

# ---- Web app ----
VITE_API_BASE_URL=http://localhost:4000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me

Web: http://localhost:5173
1. empresa@demo.com.br / EmpresaDemo123!, 
2. engenheiro@zoppi.com.br / ZoppiEng123!, 
3. admin@zoppi.com.br / ZoppiAdmin123!